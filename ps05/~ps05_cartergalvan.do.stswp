* ECON 689 - Problem Set 5
* Carter Galvan
* Problem 2

global storage "C:/Users/iamca/OneDrive - Texas A&M University"
global dataready "$storage/econ689_data/ps01/data"

use "$dataready/card.dta", clear

* Problem 2(a)
regress lwage educ exper expersq black south smsa smsa66 ///
    reg662 reg663 reg664 reg665 reg666 reg667 reg668 reg669

scalar SSR_u = e(rss)
scalar df_u = e(df_r)

display "Unrestricted SSR = " SSR_u
display "Residual degrees of freedom = " df_u

* Problem 2(b)
test reg662 reg663 reg664 reg665 reg666 reg667 reg668 reg669

scalar F_test = r(F)
scalar p_test = r(p)

display "F statistic = " F_test
display "P-value = " p_test

* Problem 2(c)
regress lwage educ exper expersq black south smsa smsa66

scalar SSR_r = e(rss)
scalar F_manual = ((SSR_r - SSR_u)/8)/(SSR_u/df_u)

display "Restricted SSR = " SSR_r
display "Manual F = " F_manual
display "Stata F = " F_test

* Problem 3(a): Simulated data
clear
set seed 2026
set obs 500

generate x1 = rnormal(0,1)
generate v = rnormal(0,1)
generate x2 = 0.5*x1 + v
generate x3 = rnormal(1,1)
generate u = rnormal(0,2)
generate y = 1 + x1 + 0.5*x2 - 0.5*x3 + u

summarize x1 v x2 x3 u y

regress y x1 x2 x3

* Problem 3(b): Joint F-test
test (x1 = 1) (x2 + x3 = 0)

scalar F_test3 = r(F)
scalar p_test3 = r(p)

display "Problem 3 F statistic = " F_test3
display "Problem 3 p-value = " p_test3

* Problem 3(c): Matrix F-test
matrix b = e(b)
matrix V = e(V)

matrix R = (1,0,0,0 \ 0,1,1,0)
matrix r = (1 \ 0)

matrix d = R*b' - r
matrix W = d' * invsym(R*V*R') * d

scalar F_matrix3 = W[1,1]/2

display "Matrix F statistic = " F_matrix3
display "Stata F statistic = " F_test3
display "Difference = " abs(F_matrix3-F_test3)

if p_test3 < 0.05 {
    display "Reject the null hypothesis at 5%"
}
else {
    display "Fail to reject the null hypothesis at 5%"
}